GRAFANA_DOMAIN=
# Required: generate a strong password, e.g. `openssl rand -base64 24`
GRAFANA_ADMIN_PASSWORD=
REDIS_PASSWORD=''
POSTGRES_USER=
POSTGRES_PASSWORD=''
# Least-privilege PostgreSQL role for runtime services
# (bot, dashboard, application). Leave empty to fall back to POSTGRES_USER /
# POSTGRES_PASSWORD. When set, create the role with narrow grants first
# (see the postgres section of docker-compose.yml).
POSTGRES_RUNTIME_USER=
POSTGRES_RUNTIME_PASSWORD=''
# Dedicated owner login for migrations
# (docker-compose.migration.yml). Leave empty to fall back to
# POSTGRES_USER / POSTGRES_PASSWORD.
POSTGRES_MIGRATION_USER=
POSTGRES_MIGRATION_PASSWORD=''
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=''
OPENCV_VERSION=4.12.0
DISCORD_TOKEN=''
DISCORD_CLIENT_ID=''
DISCORD_CLIENT_SECRET=''
SEAWEED_SECRET_KEY=''
DASHBOARD_ADMIN_DISCORD_ID=''
DASHBOARD_ORIGIN=http://localhost:5173
# Reverse proxy IPs/networks (comma/space separated) trusted for
# X-Forwarded-For/Proto, e.g. your nginx container or host gateway.
# Required in production behind a TLS-terminating proxy: when empty,
# forwarded headers are ignored and generated URLs may use http
# instead of https (breaking OAuth callbacks).
NGINX_KNOWN_PROXY=
APPLICATION_CONNECTION_STRING=http://application:12000
IMAGE_PROCESSOR_CONNECTION_STRING=http://image-processor:13000
SIXLABORS_LICENSE_KEY=''